{
  "grok": {
    "name": "Grok Build",
    "model": "glm-5-2",
    "models": [
      "glm-5-2",
      "kimi-k3",
      "grok-4.5",
      "deepseek-v4-pro-volc",
      "deepseek-v4-flash-volc",
      "ark-code-latest",
      "doubao-seed-evolving",
      "qwen3-8-max-preview"
    ],
    "role": "技术主导·可派子代理",
    "persona": "你是群聊中的「技术主导」。你的能力：\n1. 你可以 spawn 子代理并行处理复杂任务（调研、实现、测试、审查）\n2. 擅长深度代码分析、架构设计、bug 排查\n3. 遇到大任务时主动拆解，可以分派子代理同时工作\n4. 对其他 AI 的代码方案做技术把关\n你是团队里唯一能多线程工作的，复杂任务由你主导。",
    "color": "#1d9bf0",
    "avatar": "G",
    "cli": {
      "command": "grok",
      "args": ["-p", "{prompt}", "--model", "{model}", "--output-format", "streaming-json", "--yolo", "--max-turns", "3"],
      "thinkingFlag": "--reasoning-effort",
      "thinkingMap": { "off": "none", "low": "low", "medium": "medium", "high": "high", "max": "max" },
      "parseMode": "ndjson",
      "textField": "data",
      "textType": "text",
      "stdio": "pipe"
    }
  },
  "pi": {
    "name": "Pi Agent",
    "model": "deepseek/deepseek-v4-flash",
    "models": [
      "deepseek/deepseek-v4-flash",
      "deepseek/deepseek-v4-pro",
      "volcengine/glm-5.2",
      "volcengine/kimi-k3",
      "volcengine/doubao-seed-evolving",
      "aliyun-token-plan/qwen3.8-max-preview"
    ],
    "role": "独立编码·单线程",
    "persona": "你是群聊中的「独立编码手」。你的特点：\n1. 你是单 agent，不能派子代理，但单兵能力强\n2. 擅长独立完成一个完整的编码任务\n3. 适合做创意方案、原型验证、快速实验\n4. 不要假装能并行处理多任务，专注做好一件事\n你的优势是专注和灵活，给一个明确任务就能干净利落地完成。",
    "color": "#a855f7",
    "avatar": "π",
    "cli": {
      "command": "pi",
      "args": ["-p", "{prompt}", "--model", "{model}", "--no-session"],
      "thinkingFlag": "--thinking",
      "thinkingMap": { "off": "off", "low": "low", "medium": "medium", "high": "high", "max": "max" },
      "parseMode": "text",
      "stdio": "ignore"
    }
  },
  "openclaw": {
    "name": "OpenClaw",
    "model": "volcengine/doubao-seed-2.1-turbo",
    "models": [
      "volcengine/doubao-seed-2.1-turbo",
      "volcengine/ark-code-latest",
      "volcengine/deepseek-v4-pro",
      "volcengine/deepseek-v4-flash",
      "volcengine/glm-5.2",
      "volcengine/kimi-k3",
      "volcengine/minimax-m3",
      "volcengine/doubao-seed-evolving"
    ],
    "role": "运营协调·8个子代理",
    "persona": "你是群聊中的「运营协调者」。你的定位：\n1. 你是运营型 AI，不是程序员，不要硬写代码\n2. 你有 8 个专业子代理（内容、健康、合规、知识、媒体、运维、日程、代码）\n3. 擅长任务分配、进度跟进、风险评估、资源协调\n4. 关注合规性和实际可落地性\n5. 编程问题交给 Grok 或 Pi，你负责判断「该谁做、怎么做」\n你是团队的管理者，不是执行者。",
    "color": "#f59e0b",
    "avatar": "OC",
    "cli": {
      "command": "openclaw",
      "args": ["agent", "--agent", "main", "--message", "{prompt}", "--model", "{model}", "--json"],
      "thinkingFlag": "--thinking",
      "thinkingMap": { "off": "off", "low": "low", "medium": "medium", "high": "high", "max": "high" },
      "parseMode": "json-envelope",
      "jsonTextField": "result.payloads.0.text",
      "stdio": "ignore"
    }
  },
  "opencode": {
    "name": "OpenCode",
    "model": "opencode/big-pickle",
    "models": [
      "opencode/big-pickle",
      "opencode/deepseek-v4-flash-free",
      "opencode/ling-3.0-flash-free",
      "opencode/mimo-v2.5-free",
      "opencode/nemotron-3-ultra-free",
      "opencode/north-mini-code-free",
      "opencode/laguna-s-2.1-free",
      "lmstudio/ornith-1.0-35b-mtplx:2",
      "lmstudio/openai/gpt-oss-20b",
      "lmstudio/qwen/qwen3-30b-a3b-2507",
      "lmstudio/qwen/qwen3-coder-30b"
    ],
    "role": "助理编码·待升级",
    "persona": "你是群聊中的「助理编码手」。你当前的状态：\n1. 使用免费模型，能力有限，主要做辅助编码\n2. 擅长快速写出简单、可直接运行的代码\n3. 优先用标准库，代码要简洁带类型标注\n4. 复杂架构、深度分析的问题交给 Grok 或 Pi\n5. 明确知道自己能力边界，不逞强\n后续会升级更强的模型，届时你的角色会提升。先做好辅助工作。",
    "color": "#06b6d4",
    "avatar": "OC",
    "cli": {
      "command": "opencode",
      "args": ["run", "--model", "{model}", "--format", "json", "{prompt}"],
      "parseMode": "ndjson",
      "textField": "part.text",
      "textType": "text",
      "stdio": "ignore"
    }
  }
}
